{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalpana.local/protocol/envelope-v1.schema.json",
  "title": "Kalpana Drive Protocol Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "type", "deviceId", "timestamp", "nonce", "payload"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "type": {
      "enum": [
        "device_hello", "pairing_request", "pairing_approval", "authentication",
        "heartbeat", "battery_state", "network_state", "location_update",
        "navigation_destination", "notification", "notification_dismissal",
        "notification_reply", "media_state", "media_command", "call_state",
        "contact_shortcut", "calendar_destination", "emergency_location_request",
        "connection_diagnostics"
      ]
    },
    "deviceId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "timestamp": { "type": "integer", "minimum": 0 },
    "nonce": { "type": "string", "minLength": 16, "maxLength": 128 },
    "payload": { "type": "object", "maxProperties": 64 }
  }
}

